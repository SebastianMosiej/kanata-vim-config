(deftemplate action-i (action)
  (multi $action @n-i)
)
(deftemplate action-shift (action shift-action)
  (fork $action $shift-action (rsft lsft))
)
(deftemplate action-ctl (action ctl-action)
  (fork $action $ctl-action (lctl rctl))
)

(deflayermap (vim-normal)
  ;; reset all states
  caps esc 

  ;; motions
  up   @n-k
  down @n-j
  lft  @n-h
  rght @n-l
  h    @n-h
  j    @n-j
  k    @n-k
  l    @n-l
  b    @n-b
  w    @n-w
  0    @n-0
  4    (t! action-shift 4 @n-$)
  g    @n-g

  r    @n-r
  u    @n-u

  x    (t! action-shift @n-x @n-X)
  ;; insert
  i    (t! action-shift @n-i @n-I)
  a    (t! action-shift @n-i @n-A)
  o    (t! action-shift @n-o @n-O)

  9    (tap-dance 200 (9 lrld))
)

(defalias
  ;; Vim aliases start with i, n, v, or V to indicate the mode (layer) they are designed for (insert, normal, visual, visual-line).
  i-n (t! tap-hold caps (layer-switch vim-normal))

  n-i   (multi caps (layer-switch insert))

  n-h   lft
  n-j   down
  n-k   up
  n-l   rght
  n-b   C-lft
  n-w   C-rght
  n-0   (unshift home)
  n-$   (unshift end)
  n-G   (unshift lctl end)
  n-gg  (unshift lctl home)
  n-g   (t! action-shift (tap-dance 200 (XX @n-gg)) @n-G)
  n-u   (unmod lctl z)
  n-r   (t! action-ctl (layer-switch vim-replace) (unmod lctl y)) ;; aka $ on my lower layer

  n-x   del
  n-X   bspc

  n-I   (t! action-i @n-0)
  n-A   (t! action-i @n-$)
  n-o   (t! action-i (macro @n-$ ret))
  n-O   (t! action-i (macro @n-0 ret (unshift up)))
)
