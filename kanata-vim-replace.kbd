(deftemplate r-action (key)
  (multi del $key (layer-switch vim-normal))
)

;; 2. Definiujemy warstwę wymiany (vim-replace)
(deflayermap (vim-replace)
  ;; Jeśli użytkownik wciśnie ESC - po prostu wracamy, nic nie usuwamy (Anulowanie)
  esc (layer-switch vim-normal)

  ;; Mapujemy klawisze, które mogą być użyte do zamiany
  ;; Musisz tu wypisać wszystkie klawisze, które chcesz obsługiwać
  1 (t! r-action 1)
  2 (t! r-action 2)
  3 (t! r-action 3)
  4 (t! r-action 4)
  5 (t! r-action 5)
  6 (t! r-action 6)
  7 (t! r-action 7)
  8 (t! r-action 8)
  9 (t! r-action 9)
  0 (t! r-action 0)

  a (t! r-action a)
  b (t! r-action b)
  c (t! r-action c)
  d (t! r-action d)
  e (t! r-action e)
  f (t! r-action f)
  g (t! r-action g)
  h (t! r-action h)
  i (t! r-action i)
  j (t! r-action j)
  k (t! r-action k)
  l (t! r-action l)
  m (t! r-action m)
  n (t! r-action n)
  o (t! r-action o)
  p (t! r-action p)
  q (t! r-action q)
  r (t! r-action r)
  s (t! r-action s)
  t (t! r-action t)
  u (t! r-action u)
  v (t! r-action v)
  w (t! r-action w)
  x (t! r-action x)
  y (t! r-action y)
  z (t! r-action z)

  ; (t! r-action a)
  ' (t! r-action a)
  - (t! r-action a)
  = (t! r-action a)
  , (t! r-action a)
  . (t! r-action a)
  / (t! r-action a) 
  [ (t! r-action a)
  ] (t! r-action a)
  \ (t! r-action a)
  
  ;; Obsługa Spacji (zamiana znaku na spację)
  spc (t! r-action spc)
)